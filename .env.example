# OpenAI — TTS + AI card drafting (optional; mock/heuristic fallbacks without it)
OPENAI_API_KEY=

# Supabase — cloud sync + media storage
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# Prefer the new publishable key (sb_publishable_…). Legacy anon JWT also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server sync (preferred). New secret key sb_secret_… or legacy service_role JWT.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mobile sync target (Expo). Point at your machine or deployed web API.
EXPO_PUBLIC_API_URL=http://127.0.0.1:43127
