# OpenAI — TTS + AI card drafting (optional; mock/heuristic fallbacks without it)
OPENAI_API_KEY=

# Supabase — cloud sync + media storage
# Create a project at https://supabase.com, then:
# 1. Run supabase/migrations/001_init.sql and 002_anki_settings_media.sql in the SQL editor
# 2. Copy Project URL + service_role key (Settings → API) here
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mobile sync target (Expo). Point at your machine or deployed web API.
EXPO_PUBLIC_API_URL=http://127.0.0.1:43127
